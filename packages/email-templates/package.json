{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logchimp/email-templates",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "maizzle serve",
    "build": "NODE_ENV=production maizzle build",
    "copy": "cp -r ./dist/** ../server/src/services/mail/templates",
    "postinstall": "maizzle prepare",
    "format": "prettier --write \"templates/**/*.vue\"",
    "format:check": "prettier --check \"templates/**/*.vue\"",
    "lint": "eslint \"templates/**/*.vue\"",
    "lint:fix": "eslint \"templates/**/*.vue\" --fix"
  },
  "dependencies": {
    "@maizzle/framework": "latest",
    "@maizzle/tailwindcss": "^1.5.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.2"
  }
}
