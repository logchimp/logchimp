{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@logchimp/theme",
  "description": "LogChimp default theme",
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "format": "prettier --write \"src/**/*.vue\"",
    "format:check": "prettier --check \"src/**/*.vue\"",
    "lint": "eslint \"src/**/*.vue\"",
    "lint:fix": "eslint \"src/**/*.vue\" --fix"
  },
  "dependencies": {
    "@logchimp/types": "workspace:*",
    "@phosphor-icons/vue": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/components": "14.3.0",
    "@vueuse/core": "14.3.0",
    "@vueuse/head": "1.3.1",
    "axios": "1.19.0",
    "canvas-confetti": "^1.9.4",
    "dayjs": "1.11.23",
    "deepmerge": "^4.3.1",
    "dompurify": "^3.4.15",
    "js-cookie": "^3.0.8",
    "lucide-vue": "npm:lucide-vue-next@0.546.0",
    "pinia": "2.3.1",
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.3.3",
    "uuid": "11.1.1",
    "vue": "3.5.43",
    "vue-gtag": "3.5.2",
    "vue-i18n": "^11.4.12",
    "vue-router": "4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/js-cookie": "^3.0.6",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^20.0.3",
    "prettier": "^3.9.8",
    "sass": "1.69.5",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.1.5"
  }
}
