{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.idea",
      "!packages/{server,theme,types}/dist",
      "!packages/email-templates/{.maizzle,dist}"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "parser": {
      // HTML interpolation is an experimental feature
      // and, does not support overriding, so enabling it globally.
      "interpolation": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNodejsImportProtocol": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/theme/**/*.vue",
        "packages/email-templates/templates/**/*.vue"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            // Temporarily disabled due to Biome error
            "noVueDuplicateKeys": "off"
          }
        }
      }
    }
  ]
}
